# The secrets of this CDD installation, one KEY=VALUE per line.
#
# `cdd start` reads this file into the environment, which is where the ${...}
# placeholders in deployment.yaml are expanded from. A variable already set in
# the environment wins over it, so a deployment with a secret manager can
# supply any of these from there instead.
#
# The pack ships every value empty. Fill them in before the first start, and
# keep this file readable by the account that runs CDD and nobody else.

# Seals the service credentials the Identity Server sends for each organization.
# Generate one for this installation; never reuse one from another installation:
#
#   openssl rand -base64 32
#
# Back it up and keep it the same: credentials sealed with one key cannot be
# read with another. Left empty, CDD refuses those credentials, and its calls to
# the Identity Server fail unless idp.client and idp.introspection_client are set.
SERVICE_CREDENTIALS_ENCRYPTION_KEY=

# The password the Identity Server presents on the CDD synchronisation
# endpoints. It must equal admin_password in the [customer_data_service] block
# of the Identity Server's deployment.toml. Left empty, every synchronisation
# call is refused.
AUTH_SERVER_ADMIN_PASSWORD=

# Only with an external database (datasource) or a message broker.
DB_PASSWORD=
BROKER_PASSWORD=
